{
  "name": "@taglore/whats-new",
  "version": "1.2.1",
  "description": "What's New dialog and changelog page for Taglore release notes: React components and framework-free web components for any frontend.",
  "license": "MIT",
  "homepage": "https://github.com/d2k-klin/taglore/tree/main/packages/whats-new#readme",
  "publishConfig": { "access": "public" },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d2k-klin/taglore.git",
    "directory": "packages/whats-new"
  },
  "keywords": [
    "whats-new",
    "release-notes",
    "changelog",
    "react",
    "web-component",
    "custom-element",
    "taglore"
  ],
  "sideEffects": [
    "*.css",
    "./dist/element.js"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./styles.css": "./styles.css"
  },
  "files": [
    "dist",
    "styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/write-css.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "react": "^19.3.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  }
}
