{
  "name": "taglore",
  "version": "1.2.0",
  "description": "AI-written release notes from git tags. Publishes to GitHub Releases, an output folder for Docker builds, workflow artifacts and S3.",
  "license": "MIT",
  "homepage": "https://github.com/d2k-klin/taglore#readme",
  "publishConfig": { "access": "public" },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/d2k-klin/taglore.git",
    "directory": "packages/taglore"
  },
  "keywords": ["release-notes", "changelog", "github-actions", "copilot", "ai", "semver", "whats-new"],
  "bin": {
    "taglore": "dist/cli.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@actions/artifact": "^6.3.1",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@aws-sdk/client-s3": "^3.1166.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
